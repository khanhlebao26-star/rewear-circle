        <mxCell id="e_ru_rep" edge="1" parent="1" source="ru" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9AA1A9;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" target="report" value="reporter">
          <mxGeometry relative="1" as="geometry" />
