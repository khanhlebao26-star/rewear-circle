        <mxCell id="e_rl_ma" edge="1" parent="1" source="rl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9AA1A9;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" target="ma" value="1 : N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_case_audit" edge="1" parent="1" source="case" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" target="audit" value="1 : N">
