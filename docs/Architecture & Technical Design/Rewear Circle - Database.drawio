<mxfile host="app.diagrams.net" agent="Codex" pages="2">
  <diagram id="core-db" name="01 - Giao dịch và thanh toán">
    <mxGraphModel dx="1250" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_title" value="REWEAR CIRCLE — Mô hình dữ liệu giao dịch" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#142234;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1700" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1_intro" value="Mô hình logic cho MongoDB • Đường nối biểu thị quan hệ tham chiếu • Mỗi listing chỉ có 1 món • Cấu trúc nhúng/tách collection và kiểu trường cuối cùng cần xác nhận trước khi triển khai." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="77" width="1780" height="64" as="geometry" />
        </mxCell>
        <mxCell id="u" value="&lt;b&gt;users&lt;/b&gt;&lt;br/&gt;_id&lt;br/&gt;authIdentity · displayName · emailVerifiedAt&lt;br/&gt;accountStatus · createdAt&lt;br/&gt;&lt;i&gt;Một tài khoản mua và bán&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F5F9FF;strokeColor=#4D78B6;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="270" height="185" as="geometry" />
        </mxCell>
        <mxCell id="cart" value="&lt;b&gt;carts&lt;/b&gt;&lt;br/&gt;_id · userId [unique]&lt;br/&gt;updatedAt&lt;br/&gt;&lt;i&gt;Chỉ người dùng đăng nhập&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Giỏ không giữ món&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F5F9FF;strokeColor=#4D78B6;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="375" y="190" width="270" height="185" as="geometry" />
        </mxCell>
        <mxCell id="lst" value="&lt;b&gt;listings&lt;/b&gt;&lt;br/&gt;_id · sellerId&lt;br/&gt;approvedVersionId&lt;br/&gt;saleStatus: AVAILABLE / RESERVED / SOLD&lt;br/&gt;sellerHidden · adminHidden&lt;br/&gt;awaitingApprovedEdit · paymentReviewHold&lt;br/&gt;createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F5F9FF;strokeColor=#4D78B6;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="50" y="465" width="270" height="225" as="geometry" />
        </mxCell>
        <mxCell id="ver" value="&lt;b&gt;listing_versions&lt;/b&gt;&lt;br/&gt;_id · listingId&lt;br/&gt;approvalStatus: DRAFT / PENDING / APPROVED / REJECTED&lt;br/&gt;fullProductData (giá, mô tả, ảnh...)&lt;br/&gt;submittedAt · reviewedBy&lt;br/&gt;resubmissionNo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F5F9FF;strokeColor=#4D78B6;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="375" y="465" width="290" height="225" as="geometry" />
        </mxCell>
        <mxCell id="res" value="&lt;b&gt;reservations&lt;/b&gt;&lt;br/&gt;_id · listingId · checkoutId&lt;br/&gt;reservedAt · expiresAt&lt;br/&gt;state · gatewayCheckedAt&lt;br/&gt;&lt;i&gt;Chỉ tạo lúc xác nhận mua&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Hết 15 phút tra cổng; chưa rõ tra lại +1/+3/+5 phút&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F1FBF7;strokeColor=#2D8A68;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="50" y="780" width="270" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="&lt;b&gt;cart_items&lt;/b&gt;&lt;br/&gt;_id · cartId · listingId&lt;br/&gt;addedAt · quantity = 1&lt;br/&gt;&lt;i&gt;Unique(cartId, listingId)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Không bảo đảm còn hàng&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F5F9FF;strokeColor=#4D78B6;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="375" y="780" width="270" height="210" as="geometry" />
        </mxCell>
        <mxCell id="co" value="&lt;b&gt;checkouts&lt;/b&gt;&lt;br/&gt;_id · buyerId&lt;br/&gt;totalAmount · currency · recipient&lt;br/&gt;status (gồm PAYMENT_FAILED/EXPIRED/NEEDS_REVIEW) · createdAt&lt;br/&gt;&lt;i&gt;Một lượt mua nhiều món&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Thanh toán một tổng tiền&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F1FBF7;strokeColor=#2D8A68;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="760" y="190" width="275" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ord" value="&lt;b&gt;orders&lt;/b&gt;&lt;br/&gt;_id · checkoutId&lt;br/&gt;buyerId · sellerId&lt;br/&gt;orderTotal · status · recipientSnapshot&lt;br/&gt;carrierName · trackingCode · receivedAt&lt;br/&gt;&lt;i&gt;Unique(checkoutId, sellerId)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F1FBF7;strokeColor=#2D8A68;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="760" y="480" width="275" height="205" as="geometry" />
        </mxCell>
        <mxCell id="oi" value="&lt;b&gt;order_items&lt;/b&gt;&lt;br/&gt;_id · orderId · listingId&lt;br/&gt;quantity = 1 · priceAtOrder&lt;br/&gt;productSnapshot&lt;br/&gt;&lt;i&gt;Đơn không đổi khi tin được sửa&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F1FBF7;strokeColor=#2D8A68;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1100" y="480" width="280" height="205" as="geometry" />
        </mxCell>
        <mxCell id="pa" value="&lt;b&gt;payment_attempts&lt;/b&gt;&lt;br/&gt;_id · checkoutId&lt;br/&gt;amount · currency&lt;br/&gt;provider · providerReference&lt;br/&gt;status · createdAt&lt;br/&gt;&lt;i&gt;Sandbox; MVP không retry trên cùng Checkout&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFF8EE;strokeColor=#B87924;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1450" y="190" width="295" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pe" value="&lt;b&gt;payment_events&lt;/b&gt;&lt;br/&gt;_id · paymentAttemptId&lt;br/&gt;providerEventId [unique/provider]&lt;br/&gt;verificationResult · receivedAt&lt;br/&gt;processedAt&lt;br/&gt;&lt;i&gt;Callback xử lý một lần&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFF8EE;strokeColor=#B87924;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1450" y="480" width="295" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p1note" value="&lt;b&gt;Bất biến và ranh giới quyết định&lt;/b&gt;&lt;br/&gt;• checkout.totalAmount = tổng orders.orderTotal = payment_attempts.amount.&lt;br/&gt;• Mỗi listing chỉ có tối đa một reservation đang hiệu lực; kiểm tra và giữ món phải nguyên tử.&lt;br/&gt;• RESERVED có thể đồng thời adminHidden=true. Giải phóng giữ chỗ không gỡ cờ ẩn.&lt;br/&gt;• PAY ghi SUCCESS đúng kết quả cổng; món SOLD nếu không xung đột. Chưa rõ sau +1/+3/+5 phút hoặc có Checkout khác: Checkout/đơn NEEDS_REVIEW, paymentReviewHold chặn bán/giao. Không tự giao hai Buyer hay hoàn tiền. Nhà cung cấp sandbox và ánh xạ trạng thái còn mở." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="760" y="780" width="985" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e_u_lst" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u" target="lst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_u_cart" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u" target="cart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_lst_ver" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lst" target="ver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cart_ci" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cart" target="ci">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_lst_res" value="1 : N lịch sử" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lst" target="res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_co_ord" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="co" target="ord">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ord_oi" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ord" target="oi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_co_pa" value="1 : N*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="co" target="pa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pa_pe" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pa" target="pe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_co_res" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="co" target="res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="moderation-db" name="02 - Báo cáo và kiểm duyệt">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1320" pageHeight="955" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#142234;" value="REWEAR CIRCLE — Báo cáo, kiểm duyệt và truy vết" vertex="1">
          <mxGeometry height="48" width="1350" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="p2_intro" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=2;fontColor=#1F2937;" value="Các khối màu xám là tham chiếu từ trang Giao dịch. Một danh sách vụ việc cho Admin; giữ từng báo cáo gốc và chỉ cấp cho nhân viên hỗ trợ quyền xem vụ được giao." vertex="1">
          <mxGeometry height="64" width="1350" x="40" y="77" as="geometry" />
        </mxCell>
        <mxCell id="ru" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F4F4F4;strokeColor=#9AA1A9;strokeWidth=2;fontColor=#1F2937;dashed=1;" value="&lt;b&gt;users (tham chiếu)&lt;/b&gt;&lt;br/&gt;_id&lt;br/&gt;reporterId / adminId&lt;br/&gt;assignedSupportId" vertex="1">
          <mxGeometry height="160" width="260" x="50" y="185" as="geometry" />
        </mxCell>
        <mxCell id="rl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F4F4F4;strokeColor=#9AA1A9;strokeWidth=2;fontColor=#1F2937;dashed=1;" value="&lt;b&gt;listings (tham chiếu)&lt;/b&gt;&lt;br/&gt;_id&lt;br/&gt;Báo cáo trước mua&lt;br/&gt;Quyết định ẩn/duyệt" vertex="1">
          <mxGeometry height="160" width="260" x="50" y="445" as="geometry" />
        </mxCell>
        <mxCell id="ro" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F4F4F4;strokeColor=#9AA1A9;strokeWidth=2;fontColor=#1F2937;dashed=1;" value="&lt;b&gt;orders (tham chiếu)&lt;/b&gt;&lt;br/&gt;_id · checkoutId&lt;br/&gt;DELIVERY/ITEM case&lt;br/&gt;productSnapshot của món" vertex="1">
          <mxGeometry height="160" width="260" x="50" y="705" as="geometry" />
        </mxCell>
        <mxCell id="case" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFF5F4;strokeColor=#BB5F58;strokeWidth=2;fontColor=#1F2937;" value="&lt;b&gt;cases&lt;/b&gt;&lt;br/&gt;_id · targetType: LISTING / ORDER&lt;br/&gt;targetId · status: OPEN / IN_REVIEW / CLOSED&lt;br/&gt;assignedSupportId · openedAt&lt;br/&gt;closedAt&lt;br/&gt;&lt;i&gt;Nhóm báo cáo cùng mục tiêu&lt;/i&gt;" vertex="1">
          <mxGeometry height="205" width="290" x="485" y="185" as="geometry" />
        </mxCell>
        <mxCell id="report" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFF5F4;strokeColor=#BB5F58;strokeWidth=2;fontColor=#1F2937;" value="&lt;b&gt;reports&lt;/b&gt;&lt;br&gt;_id · caseId · reporterId&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 41, 55), rgb(196, 204, 216));&quot;&gt;reportType&lt;/span&gt;: LISTING_REPORT / ORDER_COMPLAINT&lt;br&gt;reason · type: DELIVERY/ITEM&lt;br&gt;affectedOrderItemIds · createdAt&lt;br&gt;&lt;i&gt;Mỗi báo cáo gốc độc lập&lt;/i&gt;" vertex="1">
          <mxGeometry height="205" width="405" x="485" y="455" as="geometry" />
        </mxCell>
        <mxCell id="ev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFF5F4;strokeColor=#BB5F58;strokeWidth=2;fontColor=#1F2937;" value="&lt;b&gt;evidence&lt;/b&gt;&lt;br/&gt;_id · reportId&lt;br/&gt;objectRef · submittedAt&lt;br/&gt;retentionUntil&lt;br/&gt;&lt;i&gt;12 tháng sau đóng vụ&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="290" x="485" y="725" as="geometry" />
        </mxCell>
        <mxCell id="ma" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFF5F4;strokeColor=#BB5F58;strokeWidth=2;fontColor=#1F2937;" value="&lt;b&gt;moderation_actions&lt;/b&gt;&lt;br/&gt;_id · listingId · versionId&lt;br/&gt;adminId · decision · reason&lt;br/&gt;createdAt · resultingVisibility&lt;br/&gt;&lt;i&gt;Lưu lịch sử duyệt/ẩn/cho sửa&lt;/i&gt;" vertex="1">
          <mxGeometry height="205" width="315" x="930" y="185" as="geometry" />
        </mxCell>
        <mxCell id="audit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFF5F4;strokeColor=#BB5F58;strokeWidth=2;fontColor=#1F2937;" value="&lt;b&gt;audit_events&lt;/b&gt;&lt;br/&gt;_id · actorId · action&lt;br/&gt;targetType · targetId · caseId&lt;br/&gt;requestId · occurredAt · result&lt;br/&gt;&lt;i&gt;Ghi cả truy cập dữ liệu nhạy cảm&lt;/i&gt;" vertex="1">
          <mxGeometry height="205" width="315" x="930" y="455" as="geometry" />
        </mxCell>
        <mxCell id="p2note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=2;fontColor=#1F2937;" value="&lt;b&gt;Quy tắc truy cập&lt;/b&gt;&lt;br/&gt;• Support chỉ xem case được giao và dữ liệu cần cho vụ.&lt;br/&gt;• Địa chỉ/liên hệ chỉ mở khi có lý do, có log.&lt;br/&gt;• Không lưu số thẻ, CVV hoặc mật khẩu.&lt;br/&gt;• DELIVERY case: PAID/toàn đơn; ITEM: COMPLETED/chọn món theo snapshot.&lt;br/&gt;• Khiếu nại không tự hoàn tiền." vertex="1">
          <mxGeometry height="170" width="315" x="930" y="725" as="geometry" />
        </mxCell>
        <mxCell id="e_case_rep" edge="1" parent="1" source="case" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6D8099;strokeWidth=1.5;fontSize=11;fontColor=#526173;labelBackgroundColor=#FFFFFF;" target="report" value="1 : N">
