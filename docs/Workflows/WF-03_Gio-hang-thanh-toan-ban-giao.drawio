        <mxCell id="note1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;" value="Seller chịu phí vận chuyển trong giá niêm yết; mỗi Seller giao riêng. Người mua trả đúng tổng tiền của Checkout, bằng tổng các đơn theo từng người bán. Giá và thông tin được lưu lúc đặt; Seller gửi form sửa sau khi đơn đã giữ chỗ không đổi đơn hay gián đoạn thanh toán. Chỉ ghi đã thanh toán sau khi đối chiếu cổng thanh toán." vertex="1">
          <mxGeometry height="135" width="430" x="35" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;" value="Giỏ không giữ món. Checkout giữ 15 phút; hết hạn dùng VNPAY QueryDr. Chưa rõ: tra lại sau 1/3/5 phút rồi NEEDS_REVIEW, khóa bán/giao. FAILED hoặc EXPIRED đã xác minh: Checkout và Order cùng trạng thái; chỉ giải phóng món khi an toàn. Thành công muộn/xung đột: PAY ghi SUCCESS, đơn NEEDS_REVIEW, không giao trùng. Buyer chỉ tự hủy trước payment attempt; không retry. DELIVERY case khi PAID chưa giao." vertex="1">
          <mxGeometry height="165" width="460" x="1050" y="1605" as="geometry" />
