        <mxCell id="note1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;" value="Seller không tự gỡ ẩn do Admin. Nếu Buyer đã tạo đơn và được giữ chỗ trước khi Seller gửi form sửa, đơn giữ nguyên giá và thông tin; thanh toán không gián đoạn. Hết giữ chỗ không tự gỡ ẩn do bản sửa hay Admin." vertex="1">
          <mxGeometry height="150" width="420" x="40" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;" value="Đã chốt: sửa bằng form đầy đủ, ẩn bản cũ chờ Admin; tự ẩn dùng nút Hiện; Admin lỗi nặng giữ ẩn, lỗi nhẹ cho sửa; đã bán có watermark. Một tài khoản đã xác minh email được mua và đăng bán. Danh mục/size/giá/độ dài trường theo BR-LISTING-008. Giữ chỗ 15 phút sau xác nhận mua. Tối đa 5 lượt gửi lại/xem lại mỗi tin sau khi bị từ chối hoặc lỗi nhẹ; lần gửi đầu không tính." vertex="1">
