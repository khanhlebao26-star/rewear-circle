        <mxCell id="l" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;" value="Khôi phục theo nguyên nhân; món đã bán có watermark, không cho sửa hoặc mua" vertex="1">
