PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rewear_circle?replicaSet=rs0&directConnection=true
APP_ORIGIN=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Rewear Circle <no-reply@rewear.local>

# Enable only after VNPAY Sandbox credentials and public HTTPS URLs are configured.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
VNPAY_QUERY_SERVER_IP=
